# =====================================================
# AKRITI DIAGNOSTICS CENTER — RENDER PRODUCTION ENVIRONMENT
# Template for Render Environment Variables (.env.example)
# =====================================================

# --- Server & Environment ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=10000

# --- Database (Supabase PostgreSQL / Managed Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
DISABLE_PGVECTOR=true

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=generate_your_64_char_secure_random_string_here
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_REFRESH_EXPIRE_HOURS=168
JWT_ALGORITHM=HS256
PASSWORD_PEPPER=generate_your_32_char_secure_random_string_here

# --- CORS (Your Render URL or custom domain) ---
ALLOWED_ORIGINS=https://your-service.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# --- Storage (Supabase Cloud Storage) ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- Redis & Caching ---
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=300
REDIS_NEGATIVE_TTL=60
REDIS_FINANCE_TTL=60

# --- AI / LLM Copilot Settings ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Groq LLM (High-Speed Fallback) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# --- Email Notifications (Brevo API) ---
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=your_verified_email@domain.com
MAIL_FROM_NAME=Akriti Diagnostics Center

# --- WhatsApp Notifications (WASender API) ---
WASENDER_API_KEY=your_wasender_api_key

# --- Lab Identity & Payments ---
LAB_NAME=Akriti Diagnostics Center
LAB_ADDRESS=Akriti Diagnostics, Main Road
LAB_PHONE=9876543210
LAB_UPI_VPA=your_upi_id@bank
LAB_GSTIN=

# --- Security & Anti-Bot Protection ---
ENABLE_RECAPTCHA=false
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
FACE_MATCH_THRESHOLD=0.6

# --- Initial Seed Account ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_TEMP_PASSWORD=YourStrongPassword123

# --- WhatsApp Integration Service ---
WHATSAPP_ENABLED=true
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_SERVICE_TOKEN=your_secure_internal_token_here
WHATSAPP_SESSION_PATH=WHATSAPP/session
WHATSAPP_OTP_EXPIRY_SECONDS=300
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_MAX_OTP_ATTEMPTS=3
WHATSAPP_MESSAGE_TIMEOUT_SECONDS=15
WHATSAPP_MAX_RETRIES=3


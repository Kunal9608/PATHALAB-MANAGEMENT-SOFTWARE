# ==============================================================================
# AKRITI DIAGNOSTICS CENTER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Use this template for local development, Docker, and Render production deployments.
# For production on Render: copy these variable keys into the Render Dashboard.
# Generate secure keys via: python backend/scripts/generate_secrets.py
# ==============================================================================

# --- Server & Environment ---
# Options: development | production | testing
ENVIRONMENT=production
HOST=0.0.0.0
# PORT: Local Docker uses 8000. Render automatically sets PORT (typically 10000).
PORT=8000
WORKERS=1

# --- Database (PostgreSQL / Supabase / Render Postgres) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
DISABLE_PGVECTOR=true

# --- Cryptographic Security & Peppers (CRITICAL FOR PRODUCTION) ---
# NOTE: In production (ENVIRONMENT=production), the application strictly enforces:
# 1. JWT_SECRET_KEY: Minimum 32 characters (64 chars recommended), high entropy.
# 2. PASSWORD_PEPPER: Dedicated 32+ character pepper for Argon2id password hashing.
# 3. AADHAAR_PEPPER: Dedicated 32+ character pepper for HMAC Aadhaar IDs.
#    MUST NOT be identical to PASSWORD_PEPPER (cryptographic domain separation).
# 4. Default placeholders below WILL ABORT startup in production.
# Run 'python backend/scripts/generate_secrets.py' to generate valid keys.
JWT_SECRET_KEY=generate_your_64_char_secure_random_string_here
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_REFRESH_EXPIRE_HOURS=168
JWT_ALGORITHM=HS256
PASSWORD_PEPPER=generate_your_32_char_secure_random_string_here
AADHAAR_PEPPER=generate_your_distinct_32_char_secure_random_string_here

# --- CORS (Trusted Domains Allowlist) ---
ALLOWED_ORIGINS=https://akritidc.onrender.com,https://akritidc.in,https://www.akritidc.in,https://akriti-dc.getvoroa.com,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# --- File Storage (Joy.services S3 for PDF Reports) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=https://nz.in.s3.joy.services
S3_ACCESS_KEY_ID=your_joy_access_key_id
S3_SECRET_ACCESS_KEY=your_joy_secret_access_key
S3_BUCKET_NAME=pathlab-reprts
S3_REGION_NAME=default
S3_SIGNATURE_VERSION=s3v4
S3_ADDRESSING_STYLE=path

# --- Redis & Caching ---
# Set to true if using Upstash / Render Redis / local redis container
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=300
REDIS_NEGATIVE_TTL=60
REDIS_FINANCE_TTL=60
REDIS_SSL_VERIFY=true
REDIS_SSL_CA_CERTS=

# --- AI / LLM Copilot Settings ---
# Options: groq | nvidia | openai | custom
LLM_PROVIDER=groq

# Groq LLM (Recommended Primary — Ultra Fast)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA LLM (Fallback Provider)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenAI LLM (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Copilot Rate Limits (messages per minute)
COPILOT_LIMIT_ADMIN=10
COPILOT_LIMIT_STAFF=5

# --- Email Notifications (Brevo API) ---
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=kunaldixit.2995@gmail.com
MAIL_FROM_NAME=Akriti Diagnostics Center

# --- WhatsApp Notifications (WASender API - External Cloud Gateway) ---
WASENDER_API_KEY=your_wasender_api_key

# --- WhatsApp Internal Microservice (Node.js Baileys Service) ---
# NOTE: WHATSAPP_SERVICE_TOKEN must match between FastAPI and WhatsApp microservice.
# In production, it must be at least 16 characters and not use default placeholders.
WHATSAPP_ENABLED=true
WHATSAPP_SERVICE_URL=http://127.0.0.1:8005
WHATSAPP_SERVICE_PORT=8005
WHATSAPP_SERVICE_HOST=127.0.0.1
WHATSAPP_SERVICE_TOKEN=generate_your_16_or_32_char_service_token_here
WHATSAPP_SESSION_PATH=WHATSAPP/session
WHATSAPP_OTP_EXPIRY_SECONDS=300
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_MAX_OTP_ATTEMPTS=3
WHATSAPP_MESSAGE_TIMEOUT_SECONDS=15
WHATSAPP_MAX_RETRIES=3

# --- Lab Identity & Payments ---
LAB_NAME=Akriti Diagnostics Center
LAB_ADDRESS=Akriti Diagnostics, Main Road
LAB_PHONE=9876543210
LAB_UPI_VPA=your_upi_id@bank
LAB_GSTIN=

# --- Security & Anti-Bot Protection ---
ENABLE_RECAPTCHA=false
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
FACE_MATCH_THRESHOLD=0.6

# --- Initial Seed Account (Only executed if not production) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_TEMP_PASSWORD=
